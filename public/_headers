/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache
/assets/wallpapers/*
  Cache-Control: public, max-age=3600, must-revalidate
/assets/videos/*
  Cache-Control: public, max-age=3600, must-revalidate

/r/*
  Access-Control-Allow-Origin: *
